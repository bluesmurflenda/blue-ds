{
  "name": "blue-ds",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "BLUESOFT 디자인시스템 — 컴파일된 CSS · SCSS 원본 · 아이콘",
  "scripts": {
    "snapshot": "node scripts/snapshot-tokens.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "prebuild": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs",
    "build": "sass scss/main.scss:dist/main.css --no-source-map",
    "postbuild": "node scripts/sync-docs-assets.mjs && node scripts/generate-docs-tokens.mjs",
    "fix:icon-sprite": "node scripts/fix-icon-sprite-fill.mjs",
    "lint:css": "stylelint \"scss/**/*.scss\"",
    "check:nodes": "node scripts/check-nodes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check": "npm run lint:css && npm run check:nodes && npm run check:tokens",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "sass": "^1.103.1",
    "style-dictionary": "^5.5.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
